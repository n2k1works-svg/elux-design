# ─────────────────────────────────────────────────────────────────────────────
# Elux Design — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
#
# This app uses Prisma + PostgreSQL (Neon). Do NOT use a SQLite `file:` URL —
# the Prisma schema's `provider = "postgresql"` will reject it.

# PostgreSQL connection string.
# Local dev:  postgresql://user:pass@localhost:5432/elux_design?schema=public
# Neon (prod): postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# Neon adds `channel_binding=require` to its URLs by default — that's fine,
# lib/db.ts strips it automatically because Prisma's engine doesn't support it.
DATABASE_URL="postgresql://user:password@localhost:5432/elux_design?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# HMAC secret used to sign admin session tokens. MUST be set in production to
# a long random string (e.g. `openssl rand -hex 32`). If unset, the app falls
# back to a hard-coded dev value that anyone reading the source could forge.
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Contact form submissions are sent via Resend. Get a key at resend.com.
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Where contact form submissions are delivered.
CONTACT_EMAIL="hello@eluxdesign.com"

# ── Image Storage (Vercel Blob) ───────────────────────────────────────────────
# Required for admin image uploads to persist on Vercel's serverless filesystem.
#
# Setup:
# 1. Go to https://vercel.com/dashboard/stores
# 2. Create Blob Store → name it "elux-uploads"
# 3. Click the store → Settings → Link Project → select "elux-design"
# 4. Vercel will automatically set BLOB_READ_WRITE_TOKEN in your project env
#
# Once linked, do NOT set this in your local .env — Vercel injects it at deploy time.
BLOB_READ_WRITE_TOKEN=""
