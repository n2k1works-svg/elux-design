generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model Project {
  id          String   @id @default(cuid())
  site        String   @default("elux-design")
  title       String
  location    String
  category    String
  description String
  image       String   @default("/project-1.png")
  images      String   @default("[]")
  client      String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  site      String   @default("elux-design")
  quote     String
  name      String
  role      String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  site        String   @default("elux-design")
  title       String
  description String
  iconKey     String   @default("building")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutContent {
  id                String @id @default("elux-design")
  paragraph1        String @default("Elux Design is a premier building design and 3D visualization firm based in Nadi, Fiji. For over 15 years, we have been at the forefront of architectural innovation in the South Pacific, delivering projects that range from luxury waterfront residences to large-scale commercial developments across the region.")
  paragraph2        String @default("Our philosophy is rooted in the belief that great architecture should work in harmony with its environment. Fiji's tropical climate, stunning landscapes, and rich cultural heritage serve as both our inspiration and our guide. Every project we undertake is a unique response to its site, its climate, and the vision of its owner.")
  paragraph3        String @default("From the concept sketches to the final walkthrough, our integrated approach ensures that design intent is preserved at every stage, resulting in spaces that are not only beautiful but enduringly functional and deeply connected to its Pacific island context.")
  statYears         Int    @default(15)
  statProjects      Int    @default(50)
  statSpecializations Int  @default(3)
  statSatisfaction   Int    @default(100)
  statYearsLabel    String @default("Years of Experience")
  statProjectsLabel String @default("Projects Completed")
  statSpecLabel     String @default("Core Specializations")
  statSatLabel      String @default("Client Satisfaction %")
  updatedAt         DateTime @updatedAt
}

model SiteSettings {
  id            String   @id @default("elux-design")
  phone         String @default("+679 000 0000")
  email         String @default("hello@eluxdesign.com")
  location      String @default("Nadi, Fiji")
  facebook      String   @default("https://facebook.com/EluxDesign")
  instagram     String   @default("https://instagram.com/EluxDesign")
  linkedin      String   @default("")
  adminPassword String   @default("elux2026")
  updatedAt     DateTime @updatedAt
}

model LegalContent {
  type        String   @id // "terms" or "privacy"
  site        String   @default("elux-design")
  content     String   @default("")
  lastUpdated String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
